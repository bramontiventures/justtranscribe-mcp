{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.bramontiventures/justtranscribe-mcp",
  "description": "Transcribe public videos & audio (YouTube, TikTok, IG) into accurate, timestamped text via API.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/bramontiventures/justtranscribe-mcp",
    "source": "github"
  },
  "websiteUrl": "https://justtranscribe.ai/mcp",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "justtranscribe-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JUSTTRANSCRIBE_API_KEY",
          "description": "API key from https://justtranscribe.ai/api-keys (free during the beta).",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://justtranscribe.ai/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API key from https://justtranscribe.ai/api-keys>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
